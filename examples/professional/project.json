{
  "langrev": "1",
  "authors": [ "Johannes (jotrorox) Müller" ],
  "version": "0.1.0",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "../../.." ],
  "dependencies": [ "embedded" ],
  "sources": [ "src/**" ],
  "output": "build",
  "targets": {
    "professional-arduino-uno": {
      "type": "executable",
      "template": "embedded/arduino_uno",
      "safe": true,
      "panic-msg": true,
      "show-backtrace": true,
      "panicfn": "embedded::panic::handler"
    },
    "professional-esp32c3": {
      "type": "executable",
      "template": "embedded/esp32c3_supermini",
      "safe": true,
      "panic-msg": true,
      "show-backtrace": true,
      "panicfn": "embedded::panic::handler"
    },
    "professional-arduino-uno-debug": { "type": "executable", "template": "embedded/arduino_uno_debug" },
    "professional-esp32c3-debug": { "type": "executable", "template": "embedded/esp32c3_supermini_debug" },
    "flash-arduino-uno": {
      "type": "prepare",
      "depends-on": [ "professional-arduino-uno" ],
      "script-dir": "../../scripts",
      "exec-dir": ".",
      "exec": [ "flash.c3 arduino_uno build/professional-arduino-uno.elf" ]
    },
    "flash-esp32c3": {
      "type": "prepare",
      "depends-on": [ "professional-esp32c3" ],
      "script-dir": "../../scripts",
      "exec-dir": ".",
      "exec": [ "flash.c3 esp32c3_supermini build/professional-esp32c3.elf" ]
    }
  }
}
