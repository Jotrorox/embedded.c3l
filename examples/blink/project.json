{
  "langrev": "1",
  "authors": [ "Johannes (jotrorox) Müller" ],
  "version": "0.1.0",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "../../.." ],
  "dependencies": [ "embedded" ],
  "sources": [ "src/**" ],
  "output": "build",
  "targets": {
    "blink-arduino-uno": { "type": "executable", "template": "embedded/arduino_uno" },
    "blink-esp32c3": { "type": "executable", "template": "embedded/esp32c3_supermini" },
    "blink-arduino-uno-debug": { "type": "executable", "template": "embedded/arduino_uno_debug" },
    "blink-esp32c3-debug": { "type": "executable", "template": "embedded/esp32c3_supermini_debug" },
    "flash-arduino-uno": {
      "type": "prepare",
      "depends-on": [ "blink-arduino-uno" ],
      "script-dir": "../../scripts",
      "exec-dir": ".",
      "exec": [ "flash.c3 arduino_uno build/blink-arduino-uno.elf" ]
    },
    "flash-esp32c3": {
      "type": "prepare",
      "depends-on": [ "blink-esp32c3" ],
      "script-dir": "../../scripts",
      "exec-dir": ".",
      "exec": [ "flash.c3 esp32c3_supermini build/blink-esp32c3.elf" ]
    }
  }
}
